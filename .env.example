# Copy to .env and fill in. .env is git-ignored.
# Any OpenAI-compatible server with a vision model works, for example:
#   OpenAI      https://api.openai.com/v1
#   Ollama      http://localhost:11434/v1   (no key needed)
#   LM Studio   http://localhost:1234/v1    (no key needed)
OPENAI_BASE_URL=http://localhost:11434/v1
# Leave empty for servers without authentication
OPENAI_API_KEY=
# Model id exactly as the server lists it (`uv run photos2show-smoke` prints them)
MODEL=glm-5.3-flash
# Parallel AI requests; 1 = strictly one by one
AI_CONCURRENCY=2
